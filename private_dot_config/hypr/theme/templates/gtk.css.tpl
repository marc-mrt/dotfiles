/* Generated by ~/.config/hypr/theme/generate.lua (Carbonfox) — do not edit */

/* ── libadwaita named colours ───────────────────────────────
   Window/headerbar/view surfaces use bg0; dialog/card/popover/thumbnail
   are one step raised and use bg1. Dark fg goes on the light
   accent/red/green/yellow fills. libadwaita's
   --window-bg-color etc. alias these, so no custom properties are
   duplicated here. */
@define-color accent_color {{accent}};
@define-color accent_bg_color {{accent}};
@define-color accent_fg_color {{bg0}};

@define-color destructive_color {{red}};
@define-color destructive_bg_color {{red}};
@define-color destructive_fg_color {{bg0}};
@define-color success_color {{green}};
@define-color success_bg_color {{green}};
@define-color success_fg_color {{bg0}};
@define-color warning_color {{yellow}};
@define-color warning_bg_color {{yellow}};
@define-color warning_fg_color {{bg0}};
@define-color error_color {{red}};
@define-color error_bg_color {{red}};
@define-color error_fg_color {{bg0}};

@define-color window_bg_color {{bg0}};
@define-color window_fg_color {{fg}};
@define-color view_bg_color {{bg0}};
@define-color view_fg_color {{fg}};

@define-color shade_color alpha(shade(@window_bg_color, 0.5), 0.36);

@define-color headerbar_bg_color {{bg0}};
@define-color headerbar_fg_color {{fg}};
@define-color headerbar_border_color alpha(@window_fg_color, 0.08);
@define-color headerbar_backdrop_color {{bg0}};
@define-color headerbar_shade_color @shade_color;

@define-color card_bg_color {{bg1}};
@define-color card_fg_color {{fg}};
@define-color card_shade_color @shade_color;

@define-color dialog_bg_color {{bg1}};
@define-color dialog_fg_color {{fg}};
@define-color popover_bg_color {{bg1}};
@define-color popover_fg_color {{fg}};
@define-color thumbnail_bg_color {{bg1}};
@define-color thumbnail_fg_color {{fg}};

@define-color scrollbar_outline_color alpha(@window_fg_color, 0.5);
@define-color selected_bg_color {{sel}};

/* ── GTK3 base roles ─────────────────────────────────────────
   xdg-desktop-portal-gtk reads these theme_* names, not the
   libadwaita roles above that serve GTK4. With gtk_theme_name
   = Adwaita these override the stock light Adwaita colours. */
@define-color theme_bg_color {{bg0}};
@define-color theme_fg_color {{fg}};
@define-color theme_base_color {{bg0}};
@define-color theme_text_color {{fg}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{bg0}};
@define-color theme_tooltip_bg_color {{bg1}};
@define-color theme_tooltip_fg_color {{fg}};
@define-color theme_titlebar_bg_color {{bg0}};
@define-color theme_titlebar_fg_color {{fg}};

/* ── GTK3 filechooser (xdg-desktop-portal-gtk) ───────────────
   theme_* names alone do not restyle compiled filechooser
   states, so target its widgets directly. */
filechooser .view,
filechooser .view text,
filechooser treeview.view,
filechooser placesview { color: @theme_text_color; background-color: @theme_base_color; }

filechooser row { color: @theme_fg_color; }

filechooser row.activatable:hover { background-color: alpha(@theme_fg_color, 0.08); }

filechooser .view:selected,
filechooser .view text:selected,
filechooser treeview.view:selected,
filechooser row:selected { color: @theme_selected_fg_color; background-color: @theme_selected_bg_color; }

/* ── Nautilus polish (palette-independent) ───────────────────
   Scoped to window.nautilus-window so GTK3 and other apps are
   untouched. Sizes mirror the Quickshell pad: list rows 40px tall,
   controls 6px, track radius 3px, hover fg alpha 0.08, selected
   accent alpha 0.25. Direct border-radius (not --window-radius)
   because this template also feeds GTK3. */

/* Floating CSD windows match Hyprland rounding=10; tiled/maximized/fullscreen stay square. */
window.nautilus-window.csd { border-radius: 10px; }
window.nautilus-window.csd.tiled,
window.nautilus-window.csd.tiled-top,
window.nautilus-window.csd.tiled-bottom,
window.nautilus-window.csd.tiled-left,
window.nautilus-window.csd.tiled-right,
window.nautilus-window.csd.maximized,
window.nautilus-window.csd.fullscreen { border-radius: 0; }

/* Sidebar and list rows: 40px tall, 6px radius. */
window.nautilus-window .navigation-sidebar row,
window.nautilus-window .nautilus-list-view columnview > listview > row { min-height: 40px; border-radius: 6px; }
/* Grid view cells: 6px radius. */
window.nautilus-window .nautilus-grid-view gridview > child { border-radius: 6px; }

/* Hover and selection, pad-style: fg alpha 0.08 over, accent alpha 0.25 selected. */
window.nautilus-window .navigation-sidebar row.activatable:hover,
window.nautilus-window .nautilus-list-view columnview > listview > row.activatable:hover,
window.nautilus-window .nautilus-grid-view gridview > child.activatable:hover { background-color: alpha(@view_fg_color, 0.08); }
window.nautilus-window .navigation-sidebar row:selected,
window.nautilus-window .nautilus-list-view columnview > listview > row:selected,
window.nautilus-window .nautilus-grid-view gridview > child:selected { background-color: alpha(@accent_bg_color, 0.25); color: @view_fg_color; }

/* Search bar breathing room below the headerbar. */
window.nautilus-window searchbar > revealer > box { padding: 8px; }

/* Scrollbars: transparent trough, 3px-rounded trough and slider. */
window.nautilus-window scrollbar { background-color: transparent; }
window.nautilus-window scrollbar trough { border-radius: 3px; }
window.nautilus-window scrollbar slider { min-width: 8px; min-height: 8px; border-radius: 3px; background-color: alpha(@window_fg_color, 0.4); }
