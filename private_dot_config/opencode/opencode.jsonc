{
  "$schema": "https://opencode.ai/config.json",

  // Machine-agnostic only. Providers, models, MCP servers and agent models belong
  // to the machine: /etc/opencode/opencode.json (Linux) or
  // /Library/Application Support/opencode/opencode.json (macOS), merged over this.
  // Plugins are linked into plugins/ from the checkouts in .chezmoiexternal.toml.

  // caveman's plugin only reinforces each turn; its ruleset comes through here.
  "instructions": [
    "~/.agents/AGENTS.md",
    "~/.claude/CLAUDE.md",
    "~/.config/opencode/vendor/caveman/src/rules/caveman-activate.md"
  ],

  // chef's always-pause list. Cooks deny the same in their agent files.
  "permissions": [
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr ready *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr review *", "effect": "ask" },
    { "action": "shell", "resource": "gh issue comment *", "effect": "ask" },
    { "action": "shell", "resource": "git push --force*", "effect": "ask" },
    { "action": "shell", "resource": "git push -f *", "effect": "ask" }
  ]
}
