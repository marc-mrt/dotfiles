# Font
font-thicken = true
font-family = Maple Mono NF

# Window
window-padding-x = 12
window-padding-y = 8
window-save-state = always
mouse-hide-while-typing = true
window-decoration = false
background-opacity = 0.80

# Cursor
cursor-opacity = 1
cursor-style-blink = true

{{ if eq .chezmoi.os "darwin" -}}
# macOS
#
# Without this, Option sends composed characters (å, ∂, ƒ…) instead of an
# Escape prefix, and every alt+ keybind below silently does nothing.
macos-option-as-alt = true
macos-window-shadow = true

{{ end -}}
# Splits
#
# Navigation with alt+arrows; creation on alt+enter. Deliberately avoiding
# alt+{q,h,v,w,s} — zsh-edit and rc.d/08-keys.zsh bind those at the prompt,
# and a Ghostty keybind would swallow them before zsh ever sees them.
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+enter=new_split:right
keybind = alt+shift+enter=new_split:down
keybind = alt+z=toggle_split_zoom
keybind = alt+x=close_surface

# Theme
theme = Carbonfox
{{ if eq .chezmoi.os "linux" -}}
# Generated by ~/.config/hypr/theme/generate.lua — overrides the theme above.
config-file = {{ .chezmoi.homeDir }}/.config/ghostty/colors
{{ end -}}
